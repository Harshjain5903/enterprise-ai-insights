GOOGLE_CLOUD_PROJECT=your-project-id
BQ_DATASET=enterprise_ai_insights
BQ_LOCATION=US
REPORT_TZ=America/Chicago
# hard cap per query, in bytes
MAX_BYTES_BILLED=2000000000

# 1 = BigQuery sandbox (free, no billing account). Loads rebuild tables instead of MERGE.
BQ_SANDBOX=1

# studio = Gemini API with an AI Studio key (free tier)
# vertex = Vertex AI, needs billing on the project
GEMINI_BACKEND=studio
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_CLOUD_LOCATION=global

# any random string, used to hash customer ids
CUSTOMER_SALT=change-me
